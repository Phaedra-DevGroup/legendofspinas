[node name="LoreStele1" parent="Environment" groups=["lore_steles"] instance=ExtResource("19_stele")]
position = Vector2(160, 320)
lore_title = "کتیبه کهن: اشک آناهیتا"
lore_text = "«روستای اسپیناس قرن‌ها در پناه گوهر فیروزه‌ای قله سرسبز بود؛ تا آنکه سایه شوم ظلمات آب‌ها را زهر کرد...»"

[node name="LoreStele2" parent="Environment" groups=["lore_steles"] instance=ExtResource("19_stele")]
position = Vector2(1980, 320)
lore_title = "کتیبه هشدار: سنگ‌شکن ویرانه‌ها"
lore_text = "«محراب شرقی در تسخیر سنگ‌شکنی است که ضربات پتکش کوه را می‌لرزاند. ۲ کلیدسنگ را بیاب تا قفل دروازه بگشاید.»"

