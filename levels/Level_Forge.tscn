[node name="ZalSanctuary1" parent="Environment" instance=ExtResource("28_zal")]
position = Vector2(1660, 320)
lore_title = "استراحتگاه زال کهنسال (آواز کوهستان)"
lore_hint = "«آتش را که گرم کردی، چشم بر پشت‌گردنه‌ها داشته باش... این کوهستان خاطره‌های تلخی دارد.»"

[node name="ZalSanctuary2" parent="Environment" instance=ExtResource("28_zal")]
position = Vector2(3540, 320)
lore_title = "استراحتگاه زال کهنسال (نجوای سنگ)"
lore_hint = "«سنگ‌شکن از غرش کوره می‌هراسد، اما از ضربه‌های پی‌درپی تو خواهد ترسید. نفس بگیر، دیگر رهایی نیست.»"

