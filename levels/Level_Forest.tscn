[node name="LoreStele1" parent="Environment" groups=["lore_steles"] instance=ExtResource("57_stele")]
position = Vector2(270, 320)
lore_title = "کتیبه دروازه بیشه"
lore_text = "«اینجا مرز بیشه مقدس آتوساست. ای رهگذر، مه را بشکاف اما به ریشه‌ها بی‌حرمتی مکن. قارچ‌های فیروزه‌ای تو را تا شاخسار بالا می‌برند (اگر پرش را نگه داری، بلندتر!) و شاخه‌های پوسیده زیر پایت می‌شکنند.»"

