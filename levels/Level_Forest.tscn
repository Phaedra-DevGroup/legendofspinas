[node name="LoreStele2" parent="Environment" groups=["lore_steles"] instance=ExtResource("57_stele")]
position = Vector2(2690, 320)
lore_title = "کتیبه نگهبان کهن"
lore_text = "«آربوریس، کهن‌ترین درخت اسپیناس، قرن‌ها از دهانه غارهای بلورین پاسداری کرد. اکنون بلوری بنفش در پشتش می‌تپد و پوسته‌اش هر ضربه‌ای را از روبرو پس می‌زند. از پشت سر بر او بتاز، یا آنگاه که شاخه‌هایش در خاک فرو می‌رود.»"

[node name="ZalSanctuary2" parent="Environment" groups=["sanctuaries"] instance=ExtResource("58_zal")]
position = Vector2(2840, 320)
lore_title = "زال کهنسال (نجوای بیشه)"
lore_hint = "«ناله آتوسا را می‌شنوی؟ نزد او برو. اما بدان: در فاز خشم، آربوریس مه زهرآگین بر زمین می‌گستراند؛ آنگاه جای تو بر شاخه‌های بالاست، نه بر خاک.»"

